<Project>
  <PropertyGroup>
    <DarpResultsAnalyzeTestProjects Condition="'$(DarpResultsAnalyzeTestProjects)' == ''"
      >false</DarpResultsAnalyzeTestProjects>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(DarpResultsAnalyzeTestProjects)' != 'true'">
    <NoWarn>$(NoWarn);DR0004;DR0005</NoWarn>
  </PropertyGroup>

  <Target
    Name="DarpResultsAddReferenceDocumentationFiles"
    BeforeTargets="CoreCompile"
    DependsOnTargets="ResolveReferences"
  >
    <ItemGroup>
      <_DarpResultsReferenceDocumentation
        Include="@(ReferencePath->'%(RootDir)%(Directory)%(Filename).xml')"
        Condition="Exists('%(ReferencePath.RootDir)%(ReferencePath.Directory)%(ReferencePath.Filename).xml')"
      />
      <!-- AdditionalFiles is shared by all analyzers, so keep these copies away from XML-only generators. -->
      <_DarpResultsAnalyzerDocumentation
        Include="@(_DarpResultsReferenceDocumentation->'$(IntermediateOutputPath)Darp.Results.ReferenceDocumentation\%(Filename).darpresultsdocs')"
      />
    </ItemGroup>
    <Copy
      SourceFiles="@(_DarpResultsReferenceDocumentation)"
      DestinationFiles="@(_DarpResultsAnalyzerDocumentation)"
      SkipUnchangedFiles="true"
    />
    <ItemGroup>
      <AdditionalFiles Include="@(_DarpResultsAnalyzerDocumentation)" />
    </ItemGroup>
  </Target>
</Project>
